	quests: [
		{
			dependencies: ["661E54379A9CDCEE"]
			description: ["Machines accept energy through cables, but the voltage must match the machine's tier. Use thicker cables to carry more Amperage (energy packets). Use insulated wires to carry a stronger signal further and to not take damage."]
			id: "3884187493BA916A"
			shape: "circle"
			tasks: [{
				id: "1E30A0C367FC0C44"
				title: "Electricity, yay!"
				type: "checkmark"
			}]
			x: 0.0d
			y: -7.5d
		}
		{
			dependencies: ["310B08BB2DFC4D6F"]
			description: ["Allows you to produce wires much more efficiently. This should be your first machine."]
			id: "1CA4AEA25456E4E3"
			shape: "circle"
			tasks: [{
				id: "0911A0EBA1456C1C"
				item: "gtceu:ulv_wiremill"
				type: "item"
			}]
			x: -2.1999999999999997d
			y: -2.5d
		}
		{
			dependencies: ["310B08BB2DFC4D6F"]
			description: ["The Large Assembler is your first electrical multiblock. It can be upgraded with Energy Hatches, meaning you won't need to craft a new Assembler every time you move to the next voltage tier."]
			id: "5B7BC416799EA7AC"
			rewards: [{
				id: "55744549CD5040F2"
				item: "gtceu:prospector.lv"
				type: "item"
			}]
			shape: "octagon"
			size: 2.0d
